# frontend/public/_headers
/*.js
  Content-Type: application/javascript
/*.mjs
  Content-Type: application/javascript
/*.css
  Content-Type: text/css
/*.json
  Content-Type: application/json
/*.woff
  Content-Type: font/woff
/*.woff2
  Content-Type: font/woff2
/*.ttf
  Content-Type: font/ttf
/*.png
  Content-Type: image/png
/*.jpg
  Content-Type: image/jpeg
/*.svg
  Content-Type: image/svg+xml

# خروجی‌های هش‌دار Vite (assets) تغییرناپذیرند: یک سال کش + immutable
# یعنی در بازدیدهای بعدی هیچ دانلودی برای JS/CSS/فونت انجام نمی‌شود.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# فایل‌های ثابت public هش ندارند؛ یک هفته کش با اعتبارسنجی مجدد کافی است.
/avatar.webp
  Cache-Control: public, max-age=604800
/camera.webp
  Cache-Control: public, max-age=604800
/Logo-red.svg
  Cache-Control: public, max-age=2592000
/Logo-dark.svg
  Cache-Control: public, max-age=2592000
/logo-light.svg
  Cache-Control: public, max-age=2592000

# HTML باید همیشه تازه باشد تا به چانک‌های هش‌دار جدید اشاره کند.
/index.html
  Cache-Control: no-cache
