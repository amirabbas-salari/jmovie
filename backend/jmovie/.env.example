# نمونه‌ی متغیرهای محیطی بک‌اند — کپی به .env و پر شود (هرگز .env را کامیت نکنید)
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://your-site.netlify.app,http://localhost:5173
# CORS_ALLOW_ALL_ORIGINS=True   # فقط برای توسعه
DATABASE_URL=                # اختیاری؛ خالی = sqlite
REDIS_URL=                   # اختیاری؛ خالی = کش لوکال
TMDB_API_KEY=
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/   # بیس‌لینک تصاویر (پوستر/بک‌گراند/گالری)؛ در صورت استفاده از CDN یا پروکسی تصویر خودتان عوض شود
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
FRONTEND_BASE_URL=           # دامنه‌ی فرانت برای sitemap.xml (مثل https://movieverse.ir)
# --- اعلان پیام‌های فرم «حمایت از ما» (اختیاری؛ پیام‌ها همیشه در دیتابیس هم ذخیره می‌شوند) ---
TELEGRAM_BOT_TOKEN=          # توکن بات از @BotFather
TELEGRAM_CHAT_ID=            # آیدی عددی چت شما (از https://api.telegram.org/bot<TOKEN>/getUpdates)
SUPPORT_NOTIFICATION_EMAIL=  # ایمیلی که پیام‌های پشتیبانی به آن ارسال شود
EMAIL_HOST=                  # مثلاً smtp.gmail.com — خالی = ایمیل فقط در لاگ چاپ می‌شود
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=         # برای جیمیل: App Password (نه پسورد اصلی)
DEFAULT_FROM_EMAIL=MovieVerse <no-reply@example.com>
SECURE_SSL_REDIRECT=False    # بعد از اطمینان از HTTPS روی production ‏True شود
# --- دستیار سینمایی مجازی (صوتی LiveKit) — همه اختیاری؛ خالی = فقط حالت مرورگر ---
# راهنمای گرفتن کلیدهای رایگان: docs/assistant/SETUP.md
LIVEKIT_URL=                 # مثل wss://your-project-xxxx.livekit.cloud
LIVEKIT_API_KEY=             # از پنل LiveKit Cloud (Settings → API keys)
LIVEKIT_API_SECRET=          # هرگز به فرانت/گیت نرود؛ فقط سرور
ASSISTANT_ROOM_PREFIX=jmovie-assistant
ASSISTANT_TOKEN_TTL_MINUTES=15
ASSISTANT_INTERNAL_SECRET=   # سکرت مشترک جنگو و ایجنت صوتی (رشته‌ی تصادفی بلند)؛ خالی = اندپوینت ابزار بسته
# --- فقط روی سرور ایجنت صوتی (voice_agent/) ست می‌شوند، نه جنگو ---
# گفتار پیش‌فرض LiveKit Inference است (همان کلیدهای LiveKit بالا؛ کلید جدا نمی‌خواهد)
SPEECH_PROVIDER=livekit
# گزینه‌ها: groq (با GROQ_API_KEY از console.groq.com) یا local (سرور Speaches
# و Piper فارسی — راهنما: voice_agent/README.md)
GROQ_API_KEY=
# چهره‌ی ویدیویی زنده Tavus (اختیاری) — خالی = آواتار سه‌بعدی داخلی فرانت
TAVUS_API_KEY=               # از app.tavus.io
TAVUS_REPLICA_ID=            # آیدی replica (در پلاگین: face_id)
TAVUS_PERSONA_ID=            # اختیاری
OPENROUTER_MODEL=openai/gpt-4o-mini
JMOVIE_API_BASE=http://localhost:8000
